[Unit]
Description=MVX voice modulator daemon
Documentation=https://github.com/x4yi/ModularVoiceX4yi
After=pipewire.service wireplumber.service
Wants=pipewire.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/mvxd
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

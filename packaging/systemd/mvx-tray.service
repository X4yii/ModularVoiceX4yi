[Unit]
Description=MVX StatusNotifierItem tray
Documentation=https://github.com/x4yi/ModularVoiceX4yi
After=graphical-session.target mvxd.service
PartOf=graphical-session.target
Wants=mvxd.service

[Service]
Type=simple
ExecStart=/usr/bin/mvx-tray
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
